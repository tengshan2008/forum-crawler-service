# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration
MONGODB_URI=mongodb://mongo:27017/forum-crawler
MONGODB_TEST_URI=mongodb://mongo:27017/forum-crawler-test

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
# 安全密钥必须修改为强随机值（如 openssl rand -hex 32 的输出），
# 保留示例值或缺省时后端启动会直接失败（S1 fail-fast 自检）。
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret
JWT_EXPIRATION=24h

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Crawler Configuration
CRAWLER_TIMEOUT=600000
CRAWLER_RETRY_ATTEMPTS=3
MAX_CONCURRENT_TASKS=5

# Logging
LOG_LEVEL=info
