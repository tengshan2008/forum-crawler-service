# Backend Dockerfile for Development
FROM node:18-alpine

# Install Python and dependencies for crawler
RUN apk add --no-cache python3 py3-pip curl && \
    pip3 install --no-cache-dir --break-system-packages \
      beautifulsoup4 \
      requests \
      pymongo \
      redis \
      python-dotenv \
      pillow \
      scrapy

WORKDIR /app/backend

# Set development environment
ENV NODE_ENV=development

# 爬虫脚本 /app/crawler/crawl.py 通过 `from lib.xxx` 导入同级包，
# 显式声明 PYTHONPATH 避免容器内解释器未把脚本目录加入 sys.path 时 import 失败。
ENV PYTHONPATH=/app/crawler

# Install Node.js dependencies (including devDependencies)
COPY backend/package*.json ./
RUN npm install

# Copy source code
COPY backend/src ./src
COPY backend/scripts ./scripts
COPY crawler /app/crawler

# Create public/images directory for downloaded images.
# 仓库不保留 public/（内容全部运行时生成），直接建目录树；
# /app/public/images 同时是 compose 命名卷 public_images 的挂载点。
RUN mkdir -p /app/public/images/uploads && chmod -R 755 /app/public

# Expose port
EXPOSE 5000

# Start application with nodemon for hot reload
CMD ["npx", "nodemon", "src/index.js"]
