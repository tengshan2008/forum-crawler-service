# Docker Compose 插值变量（docker-compose.yml 与 docker-compose.dev.yml 共用）
#
# 用法：
#   cp docker/.env.example docker/.env
#   然后把下面两个空值替换为强随机密钥（每个各执行一次，使用不同输出）：
#     openssl rand -hex 32
#
# docker/.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 也可不建文件，直接在宿主 shell export 同名变量后再执行 docker compose。
#
# 缺省或留空时 compose 会在启动前直接报错（:? 必填插值）；
# 即使绕过 compose，后端 config.validateEnv() 也会 fail-fast 拒绝启动。

JWT_SECRET=
JWT_REFRESH_SECRET=
