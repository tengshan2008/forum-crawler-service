# Backend Dockerfile
FROM node:18-alpine

# Install Python and dependencies for crawler
RUN apk add --no-cache python3 py3-pip curl && \
    pip3 install --no-cache-dir --break-system-packages \
      beautifulsoup4 \
      requests \
      pymongo \
      redis \
      python-dotenv \
      pillow \
      scrapy

WORKDIR /app/backend

# 爬虫脚本 /app/crawler/crawl.py 通过 `from lib.xxx` 导入同级包，
# 显式声明 PYTHONPATH 避免容器内解释器未把脚本目录加入 sys.path 时 import 失败。
ENV PYTHONPATH=/app/crawler

# Install Node.js dependencies
COPY backend/package*.json ./
RUN npm install --production

# Copy source code
COPY backend/src ./src
COPY crawler /app/crawler

# Create public/images directory for downloaded images.
# 不在仓库中保留 public/（内容全部运行时生成）：此处直接建目录树，
# /app/public/images 同时是 compose 命名卷 public_images 的挂载点。
RUN mkdir -p /app/public/images/uploads && chmod -R 755 /app/public

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:5000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Start application（生产镜像必须启动 Node 服务；
# 曾被误改为 sleep infinity 导致 5000 无监听、nginx 全部 502）
CMD ["npm", "start"]

